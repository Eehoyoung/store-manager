# 운영 서버 env — /etc/storemanager/env 의 원본 목록.
# deploy/docker-compose.prod.yml 이 읽는 값 전부다. 이 파일 밖의 키는 compose 가 컨테이너에 넘기지 않는다.
#
# 처음 만들 때:
#   sudo install -m 600 -o root /opt/storemanager/deploy/env.example /etc/storemanager/env
#   sudo nano /etc/storemanager/env        # 빈 값 채우기
# 이미 env 가 있을 때 — 새로 생긴 키만 확인:
#   comm -23 <(grep -oE '^[A-Z_0-9]+=' /opt/storemanager/deploy/env.example | sort) \
#            <(sudo grep -oE '^[A-Z_0-9]+=' /etc/storemanager/env | sort)
# 적용:
#   dc up -d --build
#
# ★ [필수] 는 비어 있으면 컨테이너가 뜨지 않는다(fail-closed). 기본값을 주지 않은 것은 의도다.
# ★ 주석은 줄 단위로만. `KEY=값  # 설명` 은 compose 가 설명까지 값으로 읽을 수 있다.
# ★ 이 파일을 채운 채로 저장소에 두지 말 것. 채운 사본은 /etc/storemanager/env(600) 에만 있다.

# ─── PostgreSQL ──────────────────────────────────────────────
# ★ 소문자로 둔다. 대문자면 SQL 마다 따옴표가 필요하다.
POSTGRES_USER=sodamreview
# [필수] 생성: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=
POSTGRES_DB=sodamreview

# ─── 비밀값 [필수] — rotate-secrets.sh 가 90일마다 앞의 셋을 교체한다 ───
# 생성: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=
# 생성: openssl rand -base64 32
INTERNAL_TOKEN=
# 배달앱 자격증명 봉투암호화 마스터키. 생성: openssl rand -base64 32
CREDENTIAL_MASTER_KEY=
CREDENTIAL_KEY_ID=prod
# ★ KMS 어댑터가 없어 true 면 기동이 막힌다(T-10 보류). false 로 둔다.
CREDENTIAL_REQUIRE_KMS=false
# 리뷰 작성자 가명처리 salt. 생성: openssl rand -base64 32
# ★★ 영구 고정. 바꾸면 기존 작성자와 연결이 끊긴다. 서버 밖 두 곳에 보관(deploy/README.md §8).
AUTHOR_HASH_SALT=

# ─── 관리자·메일 (Gmail SMTP) ───────────────────────────────
# 시스템 관리자 이메일(쉼표 구분). 비면 아무도 관리자가 아니다.
APP_ADMIN_EMAILS=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# 발송 Gmail 주소
MAIL_USERNAME=
# ★ Gmail 로그인 비밀번호가 아니라 '앱 비밀번호'(2단계 인증 필요, 16자리 공백 없이)
MAIL_PASSWORD=
# 비우면 MAIL_USERNAME 으로 보낸다
MAIL_FROM=
# true 인데 위 계정이 비면 기동하지 않는다. OTP·유료전환 사전고지가 이 메일로 나간다.
MAIL_REQUIRED=true

# ─── 포트원(KG이니시스) 자동결제 [필수] ──────────────────────
# 포트원 콘솔 > 결제 연동 > 연동 정보. 테스트 채널로 첫 결제를 확인한 뒤 실채널 값으로 바꾼다.
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_INICIS_CHANNEL_KEY=
# 매일 00:10 자동결제·09:00 유료전환 사전고지. ★ false 면 체험이 끝나도 청구되지 않고 이용 중지로 넘어간다.
BILLING_SCHEDULER_ENABLED=true

# 무료체험 쿠폰번호(비공개, 개별 전달). 비면 체험을 열지 않는다.
PROMOTION_CODE=
PROMOTION_LIMIT=30

# ─── 사업자 확인 (국세청) [필수] ─────────────────────────────
# 공공데이터포털 '국세청_사업자등록정보 진위확인 및 상태조회' 일반 인증키(Decoding)
NTS_SERVICE_KEY=
BUSINESS_VERIFICATION_ENABLED=true

# ─── 사업자 정보 — 나머지는 compose 에 고정돼 있다 ───────────
# 통신판매업 신고번호. 나오면 채우고 BUSINESS_INFO_REQUIRED=true — 그 전에는 유료 결제를 열지 않는다.
BUSINESS_MAIL_ORDER_NUMBER=
BUSINESS_INFO_REQUIRED=false

# ─── DataAPI (기웅정보통신) — worker ────────────────────────
# ★ 지금은 개발계다(테스트 배포). 운영계 전환 시 URL·토큰 두 줄만 바꾸고 `dc up -d worker`.
#   운영계 https://api.mydatahub.co.kr
DATAAPI_BASE_URL=https://datahub-dev.scraping.co.kr
# [필수]
DATAAPI_TOKEN=
# ★ 댓글 등록은 되돌릴 수 없다. 테스트 매장 1곳만 연동된 상태에서만 true.
DATAAPI_WRITE_ENABLED=false
# [필수] 업체가 준 LOGINPWD 암호화 값 그대로. 예: AES_CBC_PKCS5PADDING/256
DATAAPI_ENC_SPEC=
DATAAPI_ENC_KEY=
DATAAPI_ENC_IV=
# 0 = 무제한. 테스트 토큰이면 잔여 횟수를 넣는다.
DATAAPI_CALL_BUDGET=0

# ─── AI ─────────────────────────────────────────────────────
# 비면 스텁 분류기 — 자동 예약을 하지 않아 답글이 게시되지 않는다.
ANTHROPIC_API_KEY=
# 골든셋 평가(유료). 운영자가 직접 켤 때만 true.
GOLDENSET_EVAL_ENABLED=false

# ─── 스케줄러 ───────────────────────────────────────────────
PUBLISH_SCHEDULER_ENABLED=true
# ★ 켜면 LLM 비용이 난다.
DRAFT_SCHEDULER_ENABLED=true
# ★ 개인정보 파기 배치. 끄지 말 것.
RETENTION_SCHEDULER_ENABLED=true
PRIVACY_RETENTION_DAYS=1095
# 가맹본부 개별 리뷰 조회 — 법무 검토 전 false
HQ_REVIEW_ACCESS_ENABLED=false

# ─── 네이버 확장 ────────────────────────────────────────────
# 웹스토어 등록 후 chrome-extension://<고정ID>. 비면 확장을 전부 거절한다(fail-closed).
PRODUCTION_EXTENSION_ORIGIN=

# ─── 카카오 알림톡(솔라피) — CLAUDE.md '실운영 전 필수 조치' 4개 충족 전 false 유지 ───
ALIMTALK_ENABLED=false
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=
SOLAPI_SENDER_PHONE=
SOLAPI_WEBHOOK_SECRET=
SOLAPI_TEMPLATE_RISK_REVIEW=
SOLAPI_TEMPLATE_DAILY_BRIEFING=

# ─── 백업 ───────────────────────────────────────────────────
# ★ BACKUP_DIR 은 넣지 않는다. 기본값 deploy/backups 에 이미 쌓이고 있다 — 바꾸면 백업이 두 곳으로 갈린다.
BACKUP_KEEP_DAYS=14
