# 운영 서버 env — /etc/storemanager/env 의 원본 목록.
# deploy/docker-compose.prod.yml 이 읽는 키 전부다(${KEY} 참조 + deploy/*.sh 가 읽는 키).
# ★ 이 파일 밖의 키는 서버 env 에 넣어도 효과가 없다 — compose 가 environment 블록에 적은 키만 컨테이너로 넘긴다.
# ★ deploy/preflight.sh 는 이 파일의 키가 서버 env 에 모두 있는지 검사한다(없으면 FAIL).
#   그러므로 키를 추가·삭제하면 compose 가 실제로 넘기는 키인지 먼저 확인할 것.
#
# 처음 만들 때:
#   sudo install -m 600 -o root /opt/storemanager/deploy/env.example /etc/storemanager/env
#   sudo nano /etc/storemanager/env        # 빈 값 채우기
# 이미 env 가 있을 때 — 새로 생긴 키만 확인:
#   comm -23 <(grep -oE '^[A-Z_0-9]+=' /opt/storemanager/deploy/env.example | sort) \
#            <(sudo grep -oE '^[A-Z_0-9]+=' /etc/storemanager/env | sort)
# 적용:
#   dc up -d --build
#
# 표기:
#   [필수]  = 비어 있으면 compose 의 ${KEY:?} 때문에 컨테이너가 뜨지 않는다(fail-closed).
#   [권장]  = 비어도 뜨지만 해당 기능이 멈춘다. 멈추는 내용을 각 키 위에 적었다.
#   [선택]  = 비워도 되는 키 또는 기본값이 안전한 키.
#   기본값은 compose 의 ${KEY:-기본값} 기준이다(코드 기본값과 다를 수 있어 compose 쪽을 적었다).
#
# ★ 주석은 줄 단위로만. `KEY=값  # 설명` 은 compose 가 설명까지 값으로 읽을 수 있다.
# ★ 이 파일에는 값을 채우지 말 것. 채운 사본은 /etc/storemanager/env(600) 에만 있다.

# =====================================================================
# 1. 필수 비밀 — 하나라도 비면 컨테이너가 뜨지 않는다
# =====================================================================

# --- PostgreSQL ---
# ★ 소문자로 둔다. 대문자면 SQL 마다 따옴표가 필요하다.
POSTGRES_USER=sodamreview
# [필수] DB 비밀번호. 값 얻는 곳: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=
POSTGRES_DB=sodamreview

# --- 앱 비밀값 — rotate-secrets.sh 가 90일마다 JWT_SECRET·INTERNAL_TOKEN·CREDENTIAL_MASTER_KEY 를 교체한다 ---
# [필수] 로그인 토큰 서명키. 값 얻는 곳: openssl rand -base64 64 | tr -d '\n'
# 비면: api-spring 기동 실패.
JWT_SECRET=
# [필수] Spring/Python/Worker 내부 호출 인증 토큰. 값 얻는 곳: openssl rand -base64 32
# 비면: api-spring·ai-python·worker 기동 실패.
INTERNAL_TOKEN=
# [필수] 배달앱 자격증명 봉투암호화 마스터키. 값 얻는 곳: openssl rand -base64 32
# 비면: api-spring·worker 기동 실패. ★ 잃으면 저장된 자격증명을 풀 수 없다.
CREDENTIAL_MASTER_KEY=
# [선택] 마스터키 식별자. 기본값 prod (rotate-secrets.sh 가 교체 때 바꾼다).
CREDENTIAL_KEY_ID=prod
# [선택] ★ KMS 어댑터가 없어 true 면 기동이 막힌다(T-10 보류). false 로 둔다.
CREDENTIAL_REQUIRE_KMS=false
# [필수] 리뷰 작성자 가명처리 salt. 값 얻는 곳: openssl rand -base64 32
# ★★ 영구 고정. 바꾸면 기존 작성자와 연결이 끊긴다. 서버 밖 두 곳에 보관(deploy/README.md 8장).
# 비면: api-spring 기동 실패.
AUTHOR_HASH_SALT=

# --- 외부 서비스 키 중 기동 자체를 막는 것(${KEY:?}) ---
# [필수] 국세청 사업자 진위확인 인증키. 값 얻는 곳: 공공데이터포털(data.go.kr)
#        '국세청_사업자등록정보 진위확인 및 상태조회' 활용신청 > 일반 인증키(Decoding)
# 비면: api-spring 기동 실패(가입 시 사업자 확인 불가).
NTS_SERVICE_KEY=
# [필수] DataAPI 접속 토큰(기웅정보통신 발급). 현재는 개발계 토큰이다.
# 비면: worker 기동 실패.
DATAAPI_TOKEN=
# [필수] 아래 셋은 DataAPI 업체가 준 LOGINPWD 암호화 값을 그대로 넣는다. 예: DATAAPI_ENC_SPEC=AES_CBC_PKCS5PADDING/256
# 값 얻는 곳: 업체 전달 자료. 비면: worker 기동 실패.
DATAAPI_ENC_SPEC=
DATAAPI_ENC_KEY=
DATAAPI_ENC_IV=

# =====================================================================
# 2. 결제 — 포트원(채널은 NHN KCP)
# =====================================================================
# 값 얻는 곳: 포트원 콘솔 > 결제 연동 > 연동 정보 / 채널 관리. 테스트 채널로 첫 결제를 확인한 뒤 실채널 값으로 바꾼다.
# [필수] V2 API Secret. 비면: api-spring 기동 실패.
PORTONE_API_SECRET=
# [필수] 상점 ID(store-xxxx). 비면: api-spring 기동 실패.
PORTONE_STORE_ID=
# [필수] 채널 키. ★ 이름은 INICIS 로 남아 있으나 실제로는 NHN KCP 채널 키를 넣는다(코드 키 이름 유지).
# 비면: api-spring 기동 실패(카드 등록·자동결제 불가).
PORTONE_INICIS_CHANNEL_KEY=
# [선택] 기본 true. 매일 00:10 자동결제·09:00 유료전환 사전고지.
# ★ false 면 체험이 끝나도 청구되지 않고 이용 중지로 넘어간다.
BILLING_SCHEDULER_ENABLED=true
# [권장] 무료체험 쿠폰번호(비공개, 개별 전달). 임의 문자열을 정한다.
# 비면: 체험(쿠폰 가입)을 열지 않는다.
PROMOTION_CODE=
# [선택] 쿠폰 사용 한도(건). 기본 30.
PROMOTION_LIMIT=30
# [선택] 선택형 요금(플랫폼 수별 상품) — ★ 정확히 true 일 때만 켜진다. 기본 false.
# 켜기 전 체크: 선택형 요금 PR 전부 머지·통합 테스트 통과 / 결제 채널이 NHN KCP / 법무 확인 /
#              약관 시행일 도래 / 운영계 전환(D24) 이후. 대표 승인 전 false 유지.
TIERED_PRICING_ENABLED=false

# =====================================================================
# 3. DataAPI (기웅정보통신) — worker. 토큰·암호화 값은 1장 참조
# =====================================================================
# ★ 지금은 개발계다(테스트 배포). 운영계 전환 시 URL·토큰 두 줄만 바꾸고 `dc up -d worker`.
#   운영계 https://api.mydatahub.co.kr
# [권장] 기본값 개발계. preflight 는 이 키가 env 에 명시돼 있는지 검사한다.
DATAAPI_BASE_URL=https://datahub-dev.scraping.co.kr
# [권장] ★ 댓글 등록은 되돌릴 수 없다. 기본 false. 정확히 true 일 때만 열린다.
# 테스트 매장 1곳만 연동된 상태에서만 true. 개발계도 실제 배달앱 계정으로 로그인한다.
DATAAPI_WRITE_ENABLED=false
# [선택] 호출 예산. 0 = 무제한(기본). 테스트 토큰이면 잔여 횟수를 넣는다.
DATAAPI_CALL_BUDGET=0

# =====================================================================
# 4. AI — ai-python
# =====================================================================
# [권장] 값 얻는 곳: Anthropic 콘솔 > API Keys.
# 비면: 스텁 분류기로 동작 — 자동 예약을 하지 않아 답글이 게시되지 않는다.
ANTHROPIC_API_KEY=
# [선택] 골든셋 평가(유료, 1회 약 1,500원). 운영자가 직접 켤 때만 true. 기본 false.
GOLDENSET_EVAL_ENABLED=false

# =====================================================================
# 5. 메일·알림
# =====================================================================
# --- 관리자·메일 (Gmail SMTP) ---
# [권장] 시스템 관리자 이메일(쉼표 구분). 비면: 아무도 관리자가 아니다(운영 콘솔 로그인 불가).
APP_ADMIN_EMAILS=
# [선택] 기본 smtp.gmail.com / 587.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# [권장] 발송 Gmail 주소.
MAIL_USERNAME=
# [권장] ★ Gmail 로그인 비밀번호가 아니라 '앱 비밀번호'.
# 값 얻는 곳: Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호(16자리, 공백 없이).
MAIL_PASSWORD=
# [선택] 비우면 MAIL_USERNAME 으로 보낸다.
MAIL_FROM=
# [선택] 기본 true. true 인데 위 계정이 비면 api-spring 이 기동하지 않는다.
# OTP(관리자·가맹본부 로그인)·유료전환 사전고지가 이 메일로 나간다.
MAIL_REQUIRED=true

# --- 카카오 알림톡(솔라피) — CLAUDE.md '실운영 전 필수 조치' 4개 충족 전 false 유지 ---
# 값 얻는 곳: 솔라피 콘솔(API Key 관리 / 카카오 채널 / 템플릿). 알림톡은 되돌릴 수 없다.
# [선택] 기본 false. 정확히 true 일 때만 발송한다. 비면(false): 알림톡 미발송.
ALIMTALK_ENABLED=false
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 카카오 채널 ID(pfId)
SOLAPI_PF_ID=
# 솔라피에 등록한 발신번호
SOLAPI_SENDER_PHONE=
# 솔라피 웹훅 검증 비밀값(직접 정한 임의 문자열)
SOLAPI_WEBHOOK_SECRET=
# 승인된 템플릿 ID (위험 리뷰 알림 / 일일 브리핑)
SOLAPI_TEMPLATE_RISK_REVIEW=
SOLAPI_TEMPLATE_DAILY_BRIEFING=

# =====================================================================
# 6. 사업자 정보 — 나머지(상호·대표자·주소·연락처·등록번호)는 compose 에 고정돼 있어 env 로 못 바꾼다
# =====================================================================
# [선택] 기본 true. 가입 시 국세청 사업자 확인을 한다. false 면 확인을 건너뛴다.
BUSINESS_VERIFICATION_ENABLED=true
# [권장] 통신판매업 신고번호. 값 얻는 곳: 신고 완료 후 관할 지자체 발급.
# 비면: 화면에 "신고 후 표시". 나오면 채우고 BUSINESS_INFO_REQUIRED=true — 그 전에는 유료 결제를 열지 않는다.
BUSINESS_MAIL_ORDER_NUMBER=
# [선택] 기본 false. true 면 사업자 정보 중 빈 값이 있을 때 api-spring 기동을 막는다.
BUSINESS_INFO_REQUIRED=false

# =====================================================================
# 7. 기능 플래그·스케줄러 — 기본값이 안전하다. 바꿀 이유가 있을 때만
# =====================================================================
# [선택] 기본 true. 예약된 답글 게시 스케줄러. 끄면 승인된 답글이 게시되지 않는다.
PUBLISH_SCHEDULER_ENABLED=true
# [선택] 기본 true. ★ 켜면 LLM 비용이 난다. 끄면 새 리뷰의 초안이 만들어지지 않는다.
DRAFT_SCHEDULER_ENABLED=true
# [선택] 기본 true. ★ 개인정보 파기 배치. 끄지 말 것(끄면 보유기간을 정해 두고 영구 보관하게 된다).
RETENTION_SCHEDULER_ENABLED=true
# [선택] 개인정보 보유 일수. 기본 1095(3년).
PRIVACY_RETENTION_DAYS=1095
# [선택] 가맹본부 개별 리뷰 조회. 기본 false — 법무 검토·재동의 화면 전까지 false.
HQ_REVIEW_ACCESS_ENABLED=false
# [권장] 네이버 확장 오리진. 웹스토어 등록 후 chrome-extension://<고정ID>.
# 값 얻는 곳: Chrome Web Store 개발자 대시보드 > 확장 ID. 비면: 확장을 전부 거절한다(fail-closed).
PRODUCTION_EXTENSION_ORIGIN=

# =====================================================================
# 8. 운영 스크립트
# =====================================================================
# [선택] 백업 보관 일수. 기본 14.
# ★ BACKUP_DIR 은 넣지 않는다. 기본값 deploy/backups 에 이미 쌓이고 있다 — 바꾸면 백업이 두 곳으로 갈린다.
BACKUP_KEEP_DAYS=14

# =====================================================================
# 9. 선택 튜닝 키 — 주석 처리됨(preflight 필수 검사 대상 아님). 바꿀 때만 # 를 지우고 값을 넣는다
# =====================================================================
# 비우거나 없으면 아래 기본값(= 코드 기본값)으로 동작한다. api-spring / worker 컨테이너로 넘어간다.
# --- api-spring ---
# [선택] 기본 https://api.portone.io. 값 얻는 곳: 포트원 문서(API 베이스 URL).
# PORTONE_API_BASE=
# [선택] 무통장 안내 계좌. 비면: 계좌 안내를 표시하지 않는다. 값 얻는 곳: 사업자 계좌.
# BILLING_BANK_NAME=
# BILLING_ACCOUNT_NO=
# BILLING_ACCOUNT_HOLDER=
# [선택] 기본 false. 정확히 true 일 때만 매일 09:30(KST) 운영 준비 점검의 빨강 항목을 APP_ADMIN_EMAILS 로 메일 1통 보낸다(빨강 없으면 안 보냄, 사장님에게는 안 감).
# READINESS_SUMMARY_ENABLED=false
# [선택] 마스터키 교체 중 이전 키(복호화 전용). 비면: 이전 키 없음. 값 얻는 곳: 교체 전 CREDENTIAL_MASTER_KEY.
# CREDENTIAL_PREVIOUS_KEYS=
# --- worker (celery worker + beat 한 컨테이너) ---
# [선택] DataAPI 호출 재시도 횟수. 기본 2. 늘리면 초과분이 과금된다.
# DATAAPI_MAX_ATTEMPTS=2
# [선택] 정기 수집 시각(KST 시, crontab hour 표기). 기본 10 — 하루 1회.
# COLLECT_POLL_HOURS=10
# [선택] 정기 수집 재조회 일수. 기본 2. 늘리면 초과 구간이 과금된다.
# COLLECT_LOOKBACK_DAYS=2
# [선택] 최초 연동 소급 수집 일수 / 한 번에 조회하는 구간 일수. 기본 90 / 7.
# BACKFILL_DAYS=90
# BACKFILL_CHUNK_DAYS=7
# [선택] 게시 큐 배치 크기 / BRPOP 대기 초 / 계정별 게시 간격 초 / 지터 최대 초. 기본 20 / 1 / 5 / 3.
# PUBLISH_BATCH_SIZE=20
# PUBLISH_BRPOP_TIMEOUT_SECONDS=1
# PUBLISH_RATE_LIMIT_SECONDS=5
# PUBLISH_JITTER_MAX_SECONDS=3
