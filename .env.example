# 실제 값이 아닌 키 목록입니다. 복사해서 .env 로 사용하세요: cp .env.example .env
# .env 는 .gitignore 에 의해 커밋되지 않습니다.

# --- PostgreSQL (docker-compose 의 postgres 서비스와 값을 맞출 것) ---
POSTGRES_USER=storemanager
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=storemanager
# 호스트 5432 는 다른 프로젝트(stockmate-ai)가 이미 사용 중이라 5433 을 쓴다 (docker-compose.yml 참고).
DB_URL=jdbc:postgresql://localhost:5433/storemanager
# Spring 은 DB_USERNAME/DB_PASSWORD 를 읽는다 (POSTGRES_* 와 같은 값으로 맞출 것)
DB_USERNAME=storemanager
DB_PASSWORD=changeme-local-only

# --- Redis ---
# 호스트 6379 는 다른 프로젝트(stockmate-ai)가 이미 사용 중이라 6380 을 쓴다 (docker-compose.yml 참고).
REDIS_URL=redis://localhost:6380/0

# --- JWT ---
# 생성 예: openssl rand -base64 64
JWT_SECRET=

# --- 자격증명(LOGINPWD) KMS 봉투암호화 ---
# CLAUDE.md 규칙 5: LOGINPWD 는 평문으로 로깅·저장·전송하지 않는다.
# 로컬 개발용 마스터키 생성 예: openssl rand -base64 32
CREDENTIAL_MASTER_KEY=
CREDENTIAL_KEY_ID=local-dev

# --- DataAPI (기웅정보통신) ---
# 개발계/운영계는 반드시 환경변수로 분리한다. 운영계 토큰은 로컬에 절대 두지 않는다.
DATAAPI_BASE_URL=https://datahub-dev.scraping.co.kr
DATAAPI_TOKEN=  # 미발급 (docs/09 회신 대기)
# 기본값 false: 댓글 등록(CreateComment)은 되돌릴 수 없다(수정 API 스펙 미수령).
# 개발 중 실수로 실제 리뷰에 답글이 달리는 사고를 막기 위한 안전장치이므로 임의로 true 로 바꾸지 말 것.
DATAAPI_WRITE_ENABLED=false

# --- AI Service (Python/FastAPI) ---
AI_SERVICE_URL=http://localhost:8001

# --- 서비스 간 내부 호출 인증 ---
# Spring <-> AI Service, Worker -> Spring 내부 엔드포인트 인증용 토큰
INTERNAL_TOKEN=

# --- Groble 호스팅 결제 ---
# Groble 판매자 화면에서 만든 월 정기결제 링크. 카드정보는 우리 앱으로 받지 않는다.
VITE_GROBLE_PAYMENT_URL=
