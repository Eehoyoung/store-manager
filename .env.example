# 실제 값이 아닌 키 목록입니다. 복사해서 .env 로 사용하세요: cp .env.example .env
# .env 는 .gitignore 에 의해 커밋되지 않습니다.
#
# ★ 주석은 반드시 줄 단위로 씁니다. Compose 의 .env 파서는 따옴표 없는 값 뒤의 `# ...` 를
#   값의 일부로 읽는 경우가 있어, `KEY=값  # 설명` 은 토큰 끝에 공백·문자를 붙여 놓습니다.
#   자격증명에서 이게 터지면 "토큰이 틀렸다" 로만 보이고 원인을 찾기 어렵습니다.
#
# ★ [필수] 표시가 있는 값은 비어 있으면 컨테이너가 기동하지 않습니다(fail-closed).
#   기본값을 주지 않은 것은 의도입니다 — 비밀값이 조용히 빈 문자열로 동작하면 안 됩니다.

# ─────────────────────────────────────────────────────────────
# PostgreSQL — docker-compose 의 postgres 서비스와 값을 맞출 것
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=storemanager
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=storemanager

# 호스트에서 Spring 을 직접 실행할 때만 씁니다(Docker 안에서는 Compose 가 덮어씀).
# 호스트 공개 포트는 5433 입니다 — 5432 는 타 프로젝트(stockmate-ai)가 점유 중.
DB_URL=jdbc:postgresql://localhost:5433/storemanager
DB_USERNAME=storemanager
DB_PASSWORD=changeme-local-only

# ─────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────
# Spring 은 REDIS_HOST/REDIS_PORT, Celery 워커는 REDIS_URL 을 읽습니다. 두 계열을 함께 둡니다.
# Docker 안에서는 Compose 가 redis:6379 로 덮어씁니다. 아래는 호스트 직접 실행용 값입니다.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ─────────────────────────────────────────────────────────────
# 비밀값 — [필수]
# ─────────────────────────────────────────────────────────────
# [필수] JWT 서명키. 생성: openssl rand -base64 64
JWT_SECRET=

# [필수] 자격증명(LOGINPWD) 봉투암호화 마스터키. 생성: openssl rand -base64 32
# 절대규칙 5: LOGINPWD 는 평문으로 로깅·저장·전송하지 않는다.
CREDENTIAL_MASTER_KEY=
CREDENTIAL_KEY_ID=local-dev
# 운영 배포에서는 true. 아직 AWS KMS 어댑터가 없으므로 true 로 두면 기동이 차단됩니다(T-10).
CREDENTIAL_REQUIRE_KMS=false

# [필수] 리뷰 작성자 닉네임 가명처리(author_hash) salt. 생성: openssl rand -base64 32
# 데이터처리 4번: 배민 닉네임은 마스킹되지 않은 원문으로 옵니다. 이 salt 로 가명처리합니다.
# ★ 이 값을 바꾸면 기존 author_hash 와 연결이 끊깁니다. 한 번 정하면 바꾸지 마세요.
AUTHOR_HASH_SALT=

# [필수] 서비스 간 내부 호출 공유 시크릿. 생성: openssl rand -base64 32
# Worker → Spring /internal/collect-result, 운영자 → /internal/franchises 인증에 씁니다.
# ★ 이 토큰 하나로 가맹본부 계정이 생성됩니다. 프론트·로그·저장소에 절대 남기지 마세요.
INTERNAL_TOKEN=

# 관리자 public UUID 쉼표 구분 허용목록. 비어 있으면 아무도 관리자가 아닙니다(fail-closed).
# 회원가입 후 app_user.public_id 를 조회해 채웁니다.
APP_ADMIN_USER_IDS=

# ─────────────────────────────────────────────────────────────
# DataAPI (기웅정보통신)
# ─────────────────────────────────────────────────────────────
# 개발계/운영계는 반드시 환경변수로 분리합니다. 운영계 토큰은 로컬에 두지 않습니다.
#   개발계 https://datahub-dev.scraping.co.kr
#   운영계 https://api.mydatahub.co.kr
DATAAPI_BASE_URL=https://datahub-dev.scraping.co.kr

# 발급받은 개발계 토큰. 헤더에 `Authorization: Token {값}` 으로 실립니다.
DATAAPI_TOKEN=

# ★ 기본값 false 를 유지하세요. 댓글 등록(CreateComment)은 되돌릴 수 없습니다
#   — 수정 API 스펙을 아직 못 받았습니다(T-11). 실제 리뷰에 답글이 달리는 사고를 막는 안전장치입니다.
#   실연동 검증에서도 조회부터 하고, 등록은 테스트 매장 1건으로만 켰다 끕니다.
DATAAPI_WRITE_ENABLED=false

# LOGINPWD 암호화 파라미터 — 업체가 발급한 값 그대로 넣습니다.
# ENC_SPEC 예: AES_CBC_PKCS5PADDING/256 (자바 표기 AES/CBC/PKCS5Padding 도 인식).
# ENC_KEY/ENC_IV 는 업체 지정 문자열 그대로. 원문·Base64·Hex 중 AES 길이에 맞는 해석을 자동 채택합니다.
# ★ 이 3개는 배달앱 계정 비밀번호를 감싸는 열쇠입니다. 커밋·로그 금지.
DATAAPI_ENC_SPEC=
DATAAPI_ENC_KEY=
DATAAPI_ENC_IV=

# 호출 예산 하드 게이트. 0 = 무제한(운영 기본값).
# 테스트 토큰은 이용횟수가 정해져 있고 소진되면 errCode 2003 으로 전 요청이 막힙니다.
# 여기에 잔여 횟수를 넣으면 그만큼만 호출하고 그 뒤로는 호출 자체를 하지 않습니다.
# 사용량 확인:  docker exec storemanager-worker python budget.py
# 사용량 보정:  docker exec storemanager-worker python budget.py set 3
DATAAPI_CALL_BUDGET=0

# ─────────────────────────────────────────────────────────────
# AI 서비스
# ─────────────────────────────────────────────────────────────
# 호스트 직접 실행용. Docker 안에서는 Compose 가 http://ai-python:8001 로 덮어씁니다.
AI_SERVICE_BASE_URL=http://localhost:8001

# 비어 있으면 분류기가 별점 기반 스텁으로 동작합니다(T-12).
# 스텁 상태에서는 자동 예약을 하지 않으므로 답글이 게시되지 않습니다 — 실연동 검증 시 주의.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# 스케줄러·배치 스위치
# ─────────────────────────────────────────────────────────────
# 게시 스케줄러(S9). 실연동 검증 중 자동 게시를 원치 않으면 false 로 내립니다.
PUBLISH_SCHEDULER_ENABLED=true
# 청구·미납 배치. 자체 계좌이체 청구는 폐기됐고 Groble 상태 동기화 규격 미수령 —
# ★ true 로 올리지 마세요. 돈이 잘못 청구됩니다.
BILLING_SCHEDULER_ENABLED=false

# ─────────────────────────────────────────────────────────────
# 워커 튜닝값 (전부 선택 — 미설정 시 아래 값이 기본)
# ─────────────────────────────────────────────────────────────
# 증분 조회가 없어 매 폴링마다 최근 N일을 통째로 재조회합니다(dedupe 는 Spring UPSERT).
COLLECT_LOOKBACK_DAYS=2
# 신규 매장 백필 범위와 분할 단위. 90일을 7일씩 나눠 호출합니다(타임아웃·응답크기 대비).
BACKFILL_DAYS=90
BACKFILL_CHUNK_DAYS=7
# 게시 스로틀 — 같은 계정으로 연속 등록할 때의 최소 간격(초)과 무작위 지연 상한(초).
PUBLISH_RATE_LIMIT_SECONDS=5
PUBLISH_JITTER_MAX_SECONDS=3
PUBLISH_BATCH_SIZE=20
PUBLISH_BRPOP_TIMEOUT_SECONDS=1

# ─────────────────────────────────────────────────────────────
# 웹·포트
# ─────────────────────────────────────────────────────────────
# Docker 호스트 공개 포트. stockmate-ai 의 8080/8001/5173 과 겹치지 않습니다.
STORE_MANAGER_API_PORT=18080
STORE_MANAGER_AI_PORT=18001
STORE_MANAGER_WEB_PORT=15173

# 브라우저가 호출하는 API 주소(웹 이미지 빌드 시 주입).
VITE_API_BASE_URL=http://localhost:18080/api/v1

# CORS 오리진 화이트리스트(쉼표 구분).
# ★ refresh 가 HttpOnly 쿠키라 allowCredentials=true 입니다. 이 조합에서 `*` 는
#   임의 사이트가 로그인된 세션으로 API 를 호출하게 합니다. 절대 열지 마세요.
#   Vite 개발 서버(5173 등)를 쓰려면 그 오리진을 여기에 명시적으로 추가합니다.
APP_CORS_ALLOWED_ORIGINS=http://localhost:15173

# Groble 판매자 화면에서 만든 월 정기결제 링크. 카드정보는 우리 앱으로 받지 않습니다.
VITE_GROBLE_PAYMENT_URL=
